# ========================================================
# LAKBAY PLATFORM - ENVIRONMENT CONFIGURATION TEMPLATE
# ========================================================
# Copy this file to .env or create project-specific .env files:
# - ./backend/.env
# - ./frontend-customer/.env
# - ./frontend-admin/.env

# --------------------------------------------------------
# 1. Server & Application Ports
# --------------------------------------------------------
NODE_ENV=development
PORT=5000
API_PORT=5000
CUSTOMER_WEB_PORT=3000
ADMIN_PORT=3001

# --------------------------------------------------------
# 2. Application URLs (CORS & Redirections)
# --------------------------------------------------------
API_BASE_URL=http://localhost:5000
CLIENT_URL=http://localhost:3000
ADMIN_URL=http://localhost:3001

# --------------------------------------------------------
# 3. Firebase Configuration (Admin SDK for /backend)
# --------------------------------------------------------
# Option A: Path to serviceAccountKey.json (relative to backend or absolute)
FIREBASE_SERVICE_ACCOUNT_PATH=./serviceAccountKey.json

# Option B: Individual Firebase Admin credentials (used in Docker / CI/CD)
FIREBASE_PROJECT_ID=lakbay-dev
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@lakbay-dev.iam.gserviceaccount.com
# Note: In .env, replace actual newlines with \n in the private key
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC...\n-----END PRIVATE KEY-----\n"
FIREBASE_STORAGE_BUCKET=lakbay-dev.appspot.com

# --------------------------------------------------------
# 4. Firebase Configuration (Client SDK for Frontends)
# --------------------------------------------------------
VITE_FIREBASE_API_KEY=AIzaSyDummyKeyForDevelopment12345
VITE_FIREBASE_AUTH_DOMAIN=lakbay-dev.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=lakbay-dev
VITE_FIREBASE_STORAGE_BUCKET=lakbay-dev.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789012
VITE_FIREBASE_APP_ID=1:123456789012:web:abcdef1234567890
VITE_API_BASE_URL=http://localhost:5000/api

# --------------------------------------------------------
# 5. Stripe Configuration (/backend)
# --------------------------------------------------------
STRIPE_SECRET_KEY=sk_test_51PlaceholderSecretKeyHere
STRIPE_PUBLISHABLE_KEY=pk_test_51PlaceholderPublishableKeyHere
STRIPE_WEBHOOK_SECRET=whsec_PlaceholderWebhookSigningSecretHere
STRIPE_CURRENCY=php

# --------------------------------------------------------
# 6. External Location & Weather APIs
# --------------------------------------------------------
# Geoapify API Key (used for destination search autocomplete and geocoding)
GEOAPIFY_API_KEY=placeholder_geoapify_api_key_here
VITE_GEOAPIFY_API_KEY=placeholder_geoapify_api_key_here

# OpenWeather API Key (used for destination weather and departure forecasts)
OPENWEATHER_API_KEY=placeholder_openweather_api_key_here

# --------------------------------------------------------
# 7. Initial Admin Account Provisioning (seed script)
# --------------------------------------------------------
ADMIN_NAME=Lakbay Administrator
ADMIN_EMAIL=admin@lakbay.ph
ADMIN_PASSWORD=AdminPassword123!
ADMIN_PHONE=+639171234567
